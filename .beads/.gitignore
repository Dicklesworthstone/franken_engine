# Database
*.db
*.db-shm
*.db-wal

# Lock files
*.lock

# Temporary
last-touched
*.tmp
.write.lock

# br fsqlite-ns VFS sidecars — per-machine runtime state, like -wal/-shm.
# Covers beads.db-fsqlite-ns-{gate,use} and vacuum copies named
# .beads.db.schema-migration-<ts>-<pid>-0.vacuum-fsqlite-ns-{gate,use}.
*-fsqlite-ns-gate
*-fsqlite-ns-use
*.fsqlite-migration-state
*.fsqlite-migration-state*

# Merge artifacts (temporary files from 3-way merge)
beads.base.jsonl
beads.base.meta.json
*.db-journal
*.db-wal*
*.vacuum-wal-cert*

# Database files renamed aside during recovery (fixing-beads-problems promotion)
*.db.bad_*
*.db-shm.bad_*
*.db.corrupt_backup
recovery_*/

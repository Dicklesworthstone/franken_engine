# Build outputs
/target
/fuzz/target
/fuzz/artifacts
/fuzz/coverage
/fuzz/crashes

# Nested cargo build targets — `/fuzz/target` above only matches the
# top-level `fuzz/target`, not nested ones like
# `crates/franken-engine/fuzz/target/`. The whole directory was filter-
# repo'd out of history twice (d8efc6b5 and 5294ed2d) after agents
# accidentally staged ~1 GB of cargo incremental build artifacts (the
# biggest single blob was a 576 MB dep-graph.part.bin, well over
# GitHub's 100 MB per-file limit, which makes the push fail closed).
# This pattern blocks any `**/fuzz/target/` or `**/target/` tree under
# a sub-crate so it cannot recur.
**/fuzz/target/
crates/*/fuzz/target/
**/target/

# Local reference corpora (kept outside tracked source for this repo)
/legacy_quickjs
/legacy_v8

# Local generated media
/franken_engine_illustration.png

# Editor/system noise
.DS_Store
Thumbs.db
.idea/
.vscode/
.ruff_cache/
*.swp
*.swo

# Logs and local scratch
*.log
*.tmp
*.bak
/demo_output.txt
/hierarchical-delta-review/
/examples/*/examples/

# Golden artifact test outputs (transient diff files)
tests/golden/*.actual
crates/franken-engine/tests/goldens/**/*.actual
*.actual.json

# Runtime SQLite databases
storage.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# Stray single-character junk files (editor/tool artifacts)
/=

# Additional build target directories (alternate targets, remote compilation helper)
/target2/
/target_*/
/target_rch_*/
/target_cod_*/
.codex-target-*/
.codex-tmp/
.rch_cargo_home_*/
.rch_*/

# Manual probe build artifacts
/scripts/manual/*.rlib

# Timestamped test/CI artifacts
/artifacts/

# Test-generated benchmark and gate artifacts (PID/timestamp-named)
crates/franken-engine/tests/artifacts/benchmark_e2e/
crates/franken-engine/tests/artifacts/test262_release_gate/

# UBS (Ultimate Bug Scanner) output
ubs_*.txt
ubs_*.jsonl
ubs_*.sarif
ubs_output.*

# Beads issue scratch files at root
/bd-*

# Stray directories and files from agent/test runs
/false/
/out_epic.json
/unimplemented

# Agent coordination config
.agent-mail.yaml

# Python bytecode
__pycache__/
*.pyc

# bv (beads viewer) local config and caches
.bv/

# Alternate build target directories (agent-specific)
/target_check_cc/
/target_local/

# Beads issue tracker history backups and rebuild-failed recovery artifacts
.beads/.br_history/
.beads/.br_recovery/

# Stale beads snapshot dumps (agent-generated; not canonical state)
.beads_snapshot_*/
.beads_recovery/

# NTM agent orchestration state (PIDs, summaries, rate-limit caches)
.ntm/

# Claude Code agent scratch (session locks, worktree links, rejected hunks)
.claude/

# Codex/Gemini agent scratch files
.codex
.gemini/

# Additional stray alternate build-target roots (rch / checkout)
/target_standalone/
crates/*/target_standalone/
crates/*/target/
crates/*/target_cod_*/

# Ephemeral one-off refactoring scripts (agent-generated)
apply_fix.py
fix_mut.py
fix_mut2.py
refactor_ternary.py

# Remote compilation helper local config
.rch/

# Stray scratch files at root
/tests_leak.rs

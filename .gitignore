# Golden artifact test outputs (transient diff files written by the
# assert_golden helpers on mismatch; never committed). One repo-wide rule
# covers every golden root — golden/, goldens/, golden_tests/, golden_vectors/
# — so a future helper that writes <fixture>.actual or <fixture>.actual.json
# under any of them stays ignored without per-suite gitignore upkeep
# (bd-ub6x8.15).
crates/franken-engine/tests/**/*.actual
crates/franken-engine/tests/**/*.actual.*
crates/franken-engine/tests/**/*.snap.new
crates/franken-extension-host/tests/**/*.snap.new


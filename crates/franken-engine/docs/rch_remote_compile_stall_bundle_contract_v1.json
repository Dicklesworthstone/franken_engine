  "truth_states": [
    "confirmed",
    "degraded",
    "blocked",
    "contaminated"
  ],
  "degraded_semantics": [
    "required stall tuple is present",
    "local-fallback fail-closed marker was not observed",
    "one or more optional snapshots are missing",
    "capture decision stays captured_degraded"
  ],
  "blocked_semantics": [
    "missing required remote snapshots",
    "contradictory queue or worker snapshots",
    "progress age contradictions",
    "capture decision stays fail_closed"
  ],
  "contaminated_semantics": [
    "local fallback observed fails closed",
    "remote-only truth claim is invalidated",
    "capture decision stays fail_closed",
    "truth state stays contaminated"
  ],
  "fail_closed_rules": [
    "missing required remote snapshots fail closed",
    "contradictory queue or worker snapshots fail closed",
    "local fallback observed forces contaminated fail closed truth",
    "progress_age_seconds contradictions fail closed",
    "automatic retry or resolved claims fail closed",
    "bundle must not claim it mutates beads, reservations, Agent Mail, or workers"
  ],
  "mutation_policy": {
    "mutates_br": false,
    "releases_reservations": false,
    "sends_agent_mail": false,
    "mutates_remote_workers": false,
    "operator_wording_required": "evidence-only"
  },
  "required_doc_text": [
    "It is evidence only.",
    "Missing required remote snapshots fail closed.",
    "contradictory queue or worker snapshots fail closed.",
    "local fallback observed fails closed by forcing `truth_state=contaminated` and",
    "The bundle must not claim it mutates beads, reservations, Agent Mail, or workers."
  ],

    "error_codes"
  ],
  "truth_states": [
    "confirmed",
    "degraded",
    "blocked",
    "contaminated"
  ],
  "decisions": [
    "pass",
    "degraded",
    "blocked",
    "fail_closed"
  ],
  "required_shadow_status_fields": [
    "shadow_run_id",
    "truth_state",
    "decision",
    "source_snapshot_status.br_queue",
    "source_snapshot_status.bv_robot_plan",
    "source_snapshot_status.agent_mail",
    "source_snapshot_status.rch_status",
    "source_snapshot_status.git_state",
    "source_snapshot_status.artifact_bundles",
    "source_snapshot_ids",

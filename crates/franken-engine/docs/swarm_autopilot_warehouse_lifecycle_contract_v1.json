  "degraded_semantics": [
    "required warehouse input is present",
    "no contradictions are observed",
    "no local fallback contamination is present",
    "one or more optional lifecycle snapshots are missing"
  ],
  "blocked_semantics": [
    "required warehouse lifecycle evidence is missing",
    "contradictory hindsight blocks promotion truth",
    "missing replay-preserve artifact paths block cohort truth"
  ],
  "contaminated_semantics": [
    "local fallback contamination is present",
    "warehouse lifecycle truth must fail closed",
    "automatic promotion or replay approval remains forbidden"
  ],
  "required_error_codes": [
    "FE-SWARM-AUTOPILOT-WAREHOUSE-MISSING-INPUT",
    "FE-SWARM-AUTOPILOT-WAREHOUSE-CONTRADICTORY-HINDSIGHT",

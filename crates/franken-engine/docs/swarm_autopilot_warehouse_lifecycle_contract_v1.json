    "FE-SWARM-AUTOPILOT-WAREHOUSE-LOCAL-FALLBACK"
  ],
  "fail_closed_rules": [
    "missing required warehouse lifecycle evidence fails closed",
    "contradictory hindsight fails closed",
    "missing replay-preserve artifact paths fail closed",
    "local fallback contamination fails closed",
    "automatic promotion or replay approval claims fail closed",
    "lifecycle surfaces must not claim they mutate beads, reservations, Agent Mail, workers, or live queue policy"
  ],
  "mutation_policy": {
    "advisory_only": true,
    "proof_only": true,
    "mutates_br": false,
    "releases_reservations": false,
    "sends_agent_mail": false,
    "mutates_remote_workers": false,
    "changes_live_queue_policy": false,
    "runs_cargo": false,
    "runs_rch": false,
    "automatic_promotion": false,
    "automatic_replay_approval": false
  },
  "required_doc_text": [

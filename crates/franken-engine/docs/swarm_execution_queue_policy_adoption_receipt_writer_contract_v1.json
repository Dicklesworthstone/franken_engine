    "adoption_snapshot_bundle_json": "adoption_snapshot_bundle.json",
    "evidence_hashes_json": "evidence_hashes.json",
    "events_jsonl": "events.jsonl",
    "commands_txt": "commands.txt",
    "report_md": "report.md"
  },
  "admission_requirements": {
    "candidate_bundle_decision": "pass",
    "promotion_guard_decision": "eligible_canary",
    "rollout_plan_decision": "eligible_canary",
    "rollback_comparator_verdict": "better_than_current",
    "canary_verdict_recommended_action": "continue_canary",
    "operator_decision": "adopt",
    "bundle_ids_must_match": true,
    "candidate_ids_must_match": true,
    "operator_observation_window_required": true,
    "operator_supersession_required": true
  },
  "mutation_policy": {
    "receipt_artifact_only": true,
    "changes_active_queue": false,
    "applies_live_retuning": false,
    "mutates_br": false,
    "sends_agent_mail": false,
    "mutates_remote_workers": false,
    "rewrites_historical_outcomes": false
  },
  "fail_closed_rules": [
    "missing input artifacts fail closed",
    "bad input schemas fail closed",
    "non-eligible promotion guard decisions fail closed",
    "non-continuing canary verdicts fail closed",
    "contradictory bundle or candidate identities fail closed",
    "missing operator approval fails closed",
    "missing observation window fails closed",
    "missing supersession metadata fails closed",
    "automatic adoption claims fail closed",
    "live retuning claims fail closed",
    "sustained-gain claims fail closed",
    "reject local fallback proof evidence"
  ],
  "selftest_scenarios": [
    "eligible_adoption_passes",
    "guard_reject_fails_closed",
    "rollback_worse_than_current_fails_closed",
    "missing_operator_approval_fails_closed",
    "mismatched_bundle_id_fails_closed",
    "automatic_adoption_claim_fails_closed"
  ],
  "verification_commands": [
    "bash -n scripts/swarm_execution_queue_policy_adoption_receipt_writer.sh",
    "bash -n scripts/e2e/swarm_execution_queue_policy_adoption_receipt_writer_smoke.sh",
    "shellcheck -x scripts/swarm_execution_queue_policy_adoption_receipt_writer.sh scripts/e2e/swarm_execution_queue_policy_adoption_receipt_writer_smoke.sh",
    "jq empty docs/swarm_execution_queue_policy_adoption_receipt_writer_contract_v1.json",
    "bash scripts/e2e/swarm_execution_queue_policy_adoption_receipt_writer_smoke.sh check",
    "bash scripts/e2e/swarm_execution_queue_policy_adoption_receipt_writer_smoke.sh selftest"
  ]
}

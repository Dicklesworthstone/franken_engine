    },
    {
      "field": "post_adoption_drift_ledger_json",
      "argument": "--post-adoption-drift-ledger-json",
      "schema_version": "franken-engine.swarm-execution-queue-post-adoption-drift-ledger.v1",
      "hash_required": true
    },
    {
      "field": "newer_candidate_bundle_json",
      "argument": "--newer-candidate-bundle-json",

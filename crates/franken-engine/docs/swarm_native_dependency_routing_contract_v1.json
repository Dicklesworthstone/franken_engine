  "fail_closed_rules": [
    "missing required preserved inputs fail closed",
    "required native package with missing pkg-config metadata blocks route",
    "missing required headers block route",
    "stale worker probe snapshots fail closed unless explicitly optional and degraded",
    "contradictory pkg-config and header evidence fails closed",
    "local fallback contamination fails closed",
    "unsupported worker mutation advice fails closed",
    "ambiguous build-script diagnostics fail closed"
  ],
  "blocked_rules": [
    "hdf5 required and absent blocks candidate worker",
    "required native dependency missing on candidate worker blocks route",
    "pkg-config unavailable for required native dependency blocks route",
    "missing required native headers blocks route"
  ],
  "degraded_rules": [
    "optional native dependency absent degrades confidence",
    "missing optional operator status snapshot degrades confidence",
    "missing optional worker toolchain snapshot degrades confidence"
  ],

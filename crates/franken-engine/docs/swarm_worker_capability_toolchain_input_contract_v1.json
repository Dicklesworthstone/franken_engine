      "required": true
    },
    {
      "source_id": "rch_remote_compile_stall_bundle_json",
      "argument": "--rch-remote-compile-stall-bundle-json",
      "required": true
    },
    {
      "source_id": "worker_capability_snapshot_json",
      "argument": "--worker-capability-snapshot-json",
      "required": true
    },
    {
      "source_id": "worker_toolchain_snapshot_json",
      "argument": "--worker-toolchain-snapshot-json",
      "required": true
    }
  ],
  "optional_inputs": [

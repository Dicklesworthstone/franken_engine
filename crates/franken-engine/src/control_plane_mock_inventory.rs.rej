+    #[test]
+    fn source_derivation_report_matches_inventory_counts() {
+        let derivation =
+            derive_inventory_state_in_root(&repo_root()).expect("derivation should succeed");
+
+        assert_eq!(
+            derivation
+                .source_derivation_report
+                .derived_production_occurrence_count,
+            derivation.inventory.summary.must_fix_count as u64
+        );
+        assert_eq!(
+            derivation
+                .source_derivation_report
+                .curated_test_only_occurrence_count,
+            derivation.inventory.summary.test_only_count as u64
+        );
+        assert_eq!(
+            derivation.source_derivation_report.architectural_issue_count,
+            derivation.inventory.summary.architectural_issue_count as u64
+        );
+        assert_eq!(
+            derivation.source_derivation_report.excluded_files,
+            vec!["crates/franken-engine/src/control_plane_mock_inventory.rs".to_string()]
+        );
     }
 

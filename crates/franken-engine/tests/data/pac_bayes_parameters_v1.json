{
  "schema_version": "franken-engine.pac-bayes-parameters.v1",
  "description": "PAC-Bayes bound parameters for optimization promotion eligibility (Catoni 2007 form)",
  "created_at": "2026-05-21T19:45:00Z",
  "parameters": {
    "epsilon": 0.05,
    "delta": 0.01,
    "description": "ε=0.05 (5% error tolerance), δ=0.01 (99% confidence)",
    "reference": "Catoni 2007 - PAC-Bayesian supervised classification"
  },
  "bound_computation": {
    "formula": "empirical_risk + complexity_penalty",
    "complexity_penalty_form": "sqrt((KL_divergence + ln(2*sqrt(n)/delta)) / (2*(n-1)))",
    "promotion_criterion": "PAC_bound + complexity_penalty > baseline_performance",
    "strictness": "hard_reject_on_failure"
  },
  "test_scenarios": {
    "baseline_equal": {
      "description": "PAC bound exactly equals baseline - should REJECT",
      "baseline_performance": 100.0,
      "empirical_risk": 95.0,
      "complexity_penalty": 5.0,
      "expected_promotion": false
    },
    "baseline_exceeded": {
      "description": "PAC bound exceeds baseline - should PASS",
      "baseline_performance": 100.0,
      "empirical_risk": 90.0,
      "complexity_penalty": 5.0,
      "expected_promotion": true
    },
    "high_complexity_penalty": {
      "description": "High empirical performance but high complexity penalty - should REJECT",
      "baseline_performance": 100.0,
      "empirical_risk": 80.0,
      "complexity_penalty": 25.0,
      "expected_promotion": false
    }
  }
}
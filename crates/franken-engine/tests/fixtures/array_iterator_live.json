    "expected": "length|9|true|length,length,0,length"
  },
  {
    "name": "revoked_proxy_creation_defers_failure",
    "source": "let r=Proxy.revocable([1],{});r.revoke();let result=[];for(let method of ['keys','values','entries']){let it;try{it=Array.prototype[method].call(r.proxy);result.push('created');}catch(e){result.push('creation:'+e.name);}if(it){try{it.next();}catch(e){result.push(e.name);}}}result.join('|')",
    "expected": "created|TypeError|created|TypeError|created|TypeError"
  },
  {
    "name": "revocation_after_first_next_is_seen",
    "source": "let r=Proxy.revocable([1,2],{});let it=Array.prototype.values.call(r.proxy);let first=it.next().value;r.revoke();let error='';try{it.next();}catch(e){error=e.name;}[first,error].join('|')",
    "expected": "1|TypeError"
  },
  {
    "name": "holes_use_get_not_has",

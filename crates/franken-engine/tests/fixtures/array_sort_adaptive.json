[
  {
    "name": "two_unequal_ascending_runs",
    "source": "let o={length:4096};for(let i=0;i<4096;i++)o[i]=String(10000+(i+1024)%4096);Array.prototype.sort.call(o);[o[0],o[4095],Object.keys(o).length].join('|')",
    "expected": "10000|14095|4097"
  },
  {
    "name": "descending_ties_stay_stable",
    "source": "let o={0:3,1:'3',2:2n,3:'2',4:2,5:1,length:6};Array.prototype.sort.call(o);Array.from({length:6},(_,i)=>typeof o[i]+':'+String(o[i])).join('|')",
    "expected": "number:1|bigint:2|string:2|number:2|number:3|string:3"
  },
  {
    "name": "unequal_merge_keeps_zero_identities",
    "source": "let o={0:3,1:4,2:5,3:-0,4:0,5:'0',length:6};Array.prototype.sort.call(o);[1/o[0],1/o[1],typeof o[2],o[3],o[5]].join('|')",
    "expected": "-Infinity|Infinity|string|3|5"
  },
  {
    "name": "holes_sort_but_toSorted_materializes",
    "source": "let o={0:'d',2:'a',3:undefined,6:'b',length:8};let a=Array.prototype.toSorted.call(o);Array.prototype.sort.call(o);[o[0],o[1],o[2],3 in o,4 in o,7 in a,a.length].join('|')",
    "expected": "a|b|d|true|false|true|8"
  },
  {
    "name": "exact_utf16",
    "source": "let o={0:'\\ue000',1:'\\udc00',2:'\\ud800',3:'\ud83d\ude00',4:'a',length:5};let a=Array.prototype.toSorted.call(o);a.map(x=>x.charCodeAt(0)).join('|')",
    "expected": "97|55296|55357|56320|57344"
  },
  {
    "name": "proxy_gets_precede_writes",
    "source": "let log=[];let p=new Proxy({0:'c',1:'a',2:'b',length:3},{get(t,k){log.push('g'+k);return Reflect.get(t,k)},has(t,k){log.push('h'+k);return Reflect.has(t,k)},set(t,k,v){log.push('s'+k);return Reflect.set(t,k,v)}});Array.prototype.sort.call(p);log.join('|')",
    "expected": "glength|h0|g0|h1|g1|h2|g2|s0|s1|s2"
  },
  {
    "name": "getter_mutation_is_captured_live",
    "source": "let log=[];let o={length:4,1:'b',2:'c',3:'a'};Object.defineProperty(o,'0',{configurable:true,enumerable:true,get(){log.push('get');o[3]='d';return 'z'}});let a=Array.prototype.toSorted.call(o);a.join('|')+';'+log.join('|')",
    "expected": "b|c|d|z;get"
  },
  {
    "name": "setter_refusal_keeps_completed_writes",
    "source": "let o={0:'d',1:'a',2:'c',3:'b',length:4};Object.defineProperty(o,'2',{writable:false});let error='';try{Array.prototype.sort.call(o)}catch(e){error=e.name}[error,o[0],o[1],o[2],o[3]].join('|')",
    "expected": "TypeError|a|b|c|b"
  },
  {
    "name": "observable_object_conversion_is_not_cached",
    "source": "let n=0;let o={0:{toString(){n++;return 'b'}},1:'a',length:2};Array.prototype.sort.call(o);[o[0],typeof o[1],n].join('|')",
    "expected": "a|object|1"
  },
  {
    "name": "original_conversion_throw_escapes",
    "source": "let marker={};let o={0:'z',1:{toString(){throw marker}},length:2};let same=false;try{Array.prototype.sort.call(o)}catch(e){same=e===marker}[same,o[0],typeof o[1]].join('|')",
    "expected": "true|z|object"
  },
  {
    "name": "custom_comparator_is_still_called",
    "source": "let o={0:20,1:3,2:1,length:3};let n=0;Array.prototype.sort.call(o,(a,b)=>{n++;return a-b});[o[0],o[1],o[2],n>0].join('|')",
    "expected": "1|3|20|true"
  },
  {
    "name": "invalid_comparator_precedes_length",
    "source": "let n=0;let o={get length(){n++;return 0}};let error='';try{Array.prototype.sort.call(o,3)}catch(e){error=e.name}error+'|'+n",
    "expected": "TypeError|0"
  },
  {
    "name": "symbol_not_admitted_as_primitive_key",
    "source": "let o={0:'b',1:Symbol('a'),2:'a',length:3};let error='';try{Array.prototype.sort.call(o)}catch(e){error=e.name}[error,o[0],typeof o[1],o[2]].join('|')",
    "expected": "TypeError|b|symbol|a"
  },
  {
    "name": "special_numbers_have_lexical_keys",
    "source": "let o={0:NaN,1:Infinity,2:-Infinity,3:10,4:2,5:null,6:false,7:undefined,length:8};Array.prototype.toSorted.call(o).map(x=>String(x)).join('|')",
    "expected": "-Infinity|10|2|Infinity|NaN|false|null|undefined"
  }
]

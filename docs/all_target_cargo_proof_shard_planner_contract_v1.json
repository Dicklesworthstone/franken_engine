  "component": "all_target_cargo_proof_shard_planner",
  "purpose": "Emit deterministic RCH-wrapped Cargo check, clippy, lib-test, bin-test, integration-test, and doctest proof shards before heavy validation starts.",
  "docs": {
    "runbook": "docs/ALL_TARGET_CARGO_PROOF_SHARD_PLANNER.md",
    "contract": "docs/all_target_cargo_proof_shard_planner_contract_v1.json"
  },
  "implementation_script": "scripts/all_target_cargo_proof_shard_planner.sh",
  "smoke_script": "scripts/e2e/all_target_cargo_proof_shard_planner_smoke.sh",
  "fixtures": "scripts/testdata/all_target_cargo_proof_shard_planner/cases.json",
  "input_sources": [
    {
      "source_id": "cargo_metadata_json",
      "command_shape": "preserved cargo metadata JSON",
      "required": true,
      "missing_decision": "invalid_input",
      "malformed_decision": "fail_closed"
    },
    {
      "source_id": "prior_rch_failures_json",
      "command_shape": "prior RCH failure evidence or stale target list",
      "required": false,
      "missing_decision": "pass"
    }
  ],
  "decisions": [
    "pass",
    "degraded",
    "fail_closed"
  ],
  "failure_reason_codes": [
    "FE-IW3-SHARD-MALFORMED-METADATA",
    "FE-IW3-SHARD-STALE-TARGET",
    "FE-IW3-SHARD-BARE-CARGO",
    "FE-IW3-SHARD-MISSING-TARGET-DIR",
    "FE-IW3-SHARD-LOCAL-FALLBACK"
  ],
  "required_outputs": [
    "shard_manifest.json",
    "commands.txt",
    "commands.jsonl",
    "stale_target_diagnostics.jsonl",
    "events.jsonl",
    "report.md"
  ],
  "required_manifest_fields": [
    "schema_version",
    "source_revision",
    "decision",
    "package_count",
    "target_count",
    "shard_count",
    "shards",
    "stale_target_diagnostics",
    "mutation_policy",
    "artifact_paths"
  ],
  "required_shard_fields": [
    "shard_id",
    "lane",
    "package",
    "target_name",
    "target_kind",
    "command",
    "target_dir",
    "expected_artifacts",
    "rch_policy"
  ],
  "lanes": [
    "check",
    "clippy",
    "lib_test",
    "bin_test",
    "integration_test",
    "doctest"
  ],
  "command_policy": {
    "planner_executes_commands": false,
    "required_prefix": "rch exec -- env CARGO_TARGET_DIR=",
    "heavy_cargo_example": "rch exec -- env CARGO_TARGET_DIR=/tmp/rch_target_franken_engine_all_target_shards_check CARGO_INCREMENTAL=0 CARGO_BUILD_JOBS=1 cargo check -p frankenengine-engine --all-targets",
    "bare_cargo_is_fail_closed": true,
    "local_fallback_is_rejected_fail_closed": true
  },
  "mutation_policy": {
    "advisory_only": true,
    "proof_only": true,
    "runs_cargo": false,
    "runs_rch": false,
    "mutates_br": false,
    "claims_beads": false,
    "closes_beads": false,
    "sends_agent_mail": false,
    "mutates_remote_workers": false,
    "changes_live_queue_policy": false,
    "creates_deletes_target_dirs": false
  },
  "required_fixture_cases": [
    "fixture_workspace_targets",
    "clippy_only_lint_fixture",
    "malformed_metadata_fixture",
    "stale_target_fixture"
  ],
  "validation_commands": [
    "jq empty docs/all_target_cargo_proof_shard_planner_contract_v1.json scripts/testdata/all_target_cargo_proof_shard_planner/cases.json",
    "bash -n scripts/all_target_cargo_proof_shard_planner.sh scripts/e2e/all_target_cargo_proof_shard_planner_smoke.sh",
    "bash scripts/e2e/all_target_cargo_proof_shard_planner_smoke.sh check",
    "bash scripts/e2e/all_target_cargo_proof_shard_planner_smoke.sh selftest",
    "git diff --check -- docs/ALL_TARGET_CARGO_PROOF_SHARD_PLANNER.md docs/all_target_cargo_proof_shard_planner_contract_v1.json scripts/all_target_cargo_proof_shard_planner.sh scripts/e2e/all_target_cargo_proof_shard_planner_smoke.sh scripts/testdata/all_target_cargo_proof_shard_planner/cases.json"
  ]
}

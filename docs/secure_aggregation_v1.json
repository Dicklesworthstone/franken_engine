{
  "schema_version": "franken-engine.secure-aggregation.v1",
  "track": "QQ.2",
  "protocol": "Bonawitz2017-inspired additive pairwise masking",
  "thresholds": {
    "honest_majority_assumption": "k < n/3",
    "default_collusion_threshold_k_formula": "floor((n - 1) / 3)",
    "example_participant_counts": [
      {
        "n": 3,
        "k": 0
      },
      {
        "n": 7,
        "k": 2
      },
      {
        "n": 25,
        "k": 8
      }
    ],
    "honest_majority_min_participants": 3,
    "dropout_policy": "fail_closed_reject",
    "malicious_peer_policy": "fail_closed_reject"
  },
  "implementation": {
    "rust_surface": "crates/franken-engine/src/privacy_learning_contract.rs",
    "participant_secret_type": "SecureAggregationParticipantSecret",
    "masked_update_type": "SecureAggregationMaskedUpdate",
    "receipt_type": "SecureAggregationRoundReceipt",
    "mask_domain": "FrankenEngine.SecureAggregationMask.v1",
    "receipt_domain": "FrankenEngine.SecureAggregationReceipt.v1"
  },
  "protocol_module": {
    "comment": "QQ.2 protocol boundary. Cryptographic key agreement, authentication and pairwise masking live in the workspace dp crate (T.3 / bd-cixqu.20.3).",
    "rust_surface": "crates/franken-engine/src/secure_aggregation.rs",
    "primitive_crate": "crates/dp",
    "round_coordinator_type": "SecureAggregationRound",
    "trusted_configuration_method": "authenticated_configuration",
    "authenticated_round_method": "run_authenticated",
    "participant_setup_type": "dp::key_exchange::ParticipantKeySetup",
    "key_announcement_type": "dp::key_exchange::KeyAnnouncement",
    "signed_masked_update_type": "dp::key_exchange::SignedMaskedContribution",
    "cryptography": "per-peer ephemeral X25519, HKDF-SHA256, strict Ed25519 signatures",
    "transcript_binding": ["trusted identity roster", "security epoch", "round identifier", "vector dimension", "field modulus", "complete signed key set"],
    "coordinator_inputs": "trusted public identity keys, signed public announcements, signed masked vectors; no plaintext or private mask state",
    "privacy_assumption": "at least two non-colluding participants; signatures do not prove update validity",
    "release_policy": "complete roster required; application provisions trusted identities, charges privacy budget and tracks fresh release identifiers",
    "legacy_local_driver": "run accepts plaintext PeerInput values and is only an arithmetic convenience driver",
    "peer_input_type": "PeerInput",
    "outcome_type": "SecureAggregationOutcome",
    "reject_reason_type": "SecureAggregationReject",
    "collusion_threshold_fn": "collusion_threshold_k",
    "event_type": "SecureAggregationEvent",
    "event_kinds": [
      "secure_aggregation_round_aggregated",
      "secure_aggregation_round_rejected"
    ],
    "events_sink": "events.jsonl"
  }
}

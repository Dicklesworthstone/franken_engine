  "source_snapshot_contracts": [
    {
      "source_id": "br_issue_json",
      "capture_command": "br show <bead-id> --json",
      "required": true,
      "missing_decision": "fail_closed"
    },
    {
      "source_id": "br_ready_or_list_json",
      "capture_command": "br ready --json or br list --json",
      "required": false,
      "missing_decision": "degraded"
    },
    {
      "source_id": "br_sync_status_json",
      "capture_command": "br sync --status --json",
      "required": false,
      "missing_decision": "degraded"
    },
    {
      "source_id": "bv_actionable_plan_json",
      "capture_command": "bv --recipe actionable --robot-plan",
      "required": false,
      "missing_decision": "degraded"
    },
    {
      "source_id": "agent_mail_profiles_json",
      "capture_command": "Agent Mail list_agents output",
      "required": false,
      "missing_decision": "degraded"
    },
    {
      "source_id": "agent_mail_messages_json",
      "capture_command": "Agent Mail inbox/search/thread snapshot",
      "required": false,
      "missing_decision": "degraded"
    },
    {
      "source_id": "file_reservations_json",
      "capture_command": "Agent Mail active file reservation snapshot",
      "required": false,
      "missing_decision": "degraded"
    },
    {
      "source_id": "declared_write_set_json",
      "capture_command": "current bead declared write set fixture",
      "required": false,
      "missing_decision": "degraded"
    },
    {
      "source_id": "git_status_json",
      "capture_command": "scoped git status snapshot",
      "required": false,
      "missing_decision": "degraded"
    },
    {
      "source_id": "git_closeout_commits_json",
      "capture_command": "closeout commit mapping or git log evidence",
      "required": false,
      "missing_decision": "degraded"
    },
    {
      "source_id": "rch_validation_artifacts_json",
      "capture_command": "RCH policy gate, run manifest, or command transcript artifacts",
      "required": false,
      "missing_decision": "degraded"
    },
    {
      "source_id": "validation_commands_json",
      "capture_command": "validation command transcript fixture",
      "required": false,
      "missing_decision": "degraded"
    },
    {
      "source_id": "operator_status_json",
      "capture_command": "scripts/swarm_operator_status_report.sh output",
      "required": false,
      "missing_decision": "degraded"
    }
  ],
  "required_event_fields": [
    "event_id",
    "event_type",
    "bead_id",
    "agent_name",
    "thread_id",
    "source_revision",
    "source_path",
    "artifact_path",
    "content_hash",
    "observed_at",

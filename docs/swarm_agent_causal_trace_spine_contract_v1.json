    "bead_id",
    "source_revision",
    "nodes",
    "edges",
    "anomaly_summary",
    "mutation_policy",
    "artifact_paths"
  ],
  "node_types": [
    "agent_profile",
    "bead_state",
    "mail_message",
    "file_reservation",
    "git_status",
    "git_commit",
    "validation_command",
    "rch_proof_artifact",

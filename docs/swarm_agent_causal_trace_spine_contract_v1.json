  ],
  "edge_types": [
    "agent_introduced",
    "bead_claimed",
    "reservation_covers_path",
    "message_acknowledged",
    "validation_proves_closeout",
    "commit_closes_bead",
    "operator_status_summarizes_trace",
    "artifact_hashes_source",
    "degraded_by_missing_optional_snapshot",
    "fail_closed_by_contradiction"
  ],
  "anomaly_classes": [
    "missing_claim_message",
    "missing_reservation_for_dirty_path",
    "reservation_without_matching_bead_scope",
    "local_rch_fallback_contaminates_remote_proof",
    "closed_bead_missing_commit",
    "closed_bead_missing_validation_evidence",
    "ack_required_message_unacknowledged",
    "stale_owner_recent_activity_conflict"
  ],
  "required_artifact_contracts": [
    {
      "path_key": "artifact_paths.trace_input_json",
      "schema_version": "franken-engine.swarm-agent-causal-trace-input.v1",
      "required": true
    },
    {
      "path_key": "artifact_paths.normalized_events_json",
      "schema_version": "franken-engine.swarm-agent-causal-trace-event-set.v1",
      "required": true
    },
    {
      "path_key": "artifact_paths.causal_graph_json",
      "schema_version": "franken-engine.swarm-agent-causal-trace-graph.v1",
      "required": true
    },
    {
      "path_key": "artifact_paths.anomaly_report_json",
      "schema_version": "franken-engine.swarm-agent-causal-trace-anomaly-report.v1",
      "required": true
    },
    {
      "path_key": "artifact_paths.trace_receipt_json",
      "schema_version": "franken-engine.swarm-agent-causal-trace-receipt.v1",
      "required": true
    },
    {
      "path_key": "artifact_paths.events_jsonl",
      "required": true,
      "description": "structured producer events"
    },
    {
      "path_key": "artifact_paths.commands_txt",
      "required": true,
      "description": "exact command transcript"
    },
    {
      "path_key": "artifact_paths.report_md",
      "required": true,
      "description": "operator-facing summary"
    }
  ],
  "decision_policy": {
    "pass": "all required identities and closeout evidence are linked with no anomalies",
    "degraded": "optional evidence is missing or stale but no contradiction invalidates the trace",
    "fail_closed": "required evidence is missing, contradictory, locally executed when remote proof is claimed, or unsafe automation wording is detected"
  },
  "fail_closed_rules": [
    "missing br issue snapshot fails closed",
    "closed bead without closeout commit evidence fails closed",
    "closed bead without validation evidence fails closed",
    "dirty path without matching bead scope and reservation fails closed",
    "local RCH fallback marker contaminates remote proof evidence",
    "ack_required message without acknowledgement evidence fails closed when the message is in the supplied thread snapshot",
    "contradictory owner freshness between bead state, Agent Mail activity, reservations, and git activity fails closed",
    "runbook output must not claim automatic bead repair, automatic reservation release, live Agent Mail sends, live RCH execution, or queue policy mutation"
  ],
  "mutation_policy": {
    "fixture_fed_only": true,
    "mutates_br": false,
    "reassigns_beads": false,
    "releases_reservations": false,
    "sends_agent_mail": false,
    "queries_live_agent_mail": false,
    "runs_cargo": false,
    "runs_rch": false,
    "mutates_remote_workers": false,
    "changes_live_queue_policy": false,
    "rewrites_historical_outcomes": false,
    "operator_wording_required": "advisory-only"
  },
  "planned_fixture_cases": [
    {
      "fixture_id": "healthy_closeout",
      "expected_decision": "pass",
      "description": "claim, reservation, RCH proof, validation transcript, closeout message, commit, and br close reason link into one trace"
    },
    {
      "fixture_id": "missing_agent_mail_snapshot",
      "expected_decision": "degraded",
      "description": "missing optional Agent Mail profile/message evidence remains visible degraded state"
    },
    {
      "fixture_id": "local_rch_fallback",
      "expected_decision": "fail_closed",
      "description": "local fallback marker invalidates remote proof closeout"
    },
    {
      "fixture_id": "ownership_conflict",
      "expected_decision": "fail_closed",
      "description": "dirty path, reservation holder, and bead assignee disagree"
    },
    {
      "fixture_id": "closed_without_commit",
      "expected_decision": "fail_closed",
      "description": "closed bead lacks linked closeout commit or validation proof"
    }
  ],

    "warehouse_hash",
    "decision",
    "entries",
    "artifact_paths.replay_index_json",
    "artifact_paths.anomaly_cohorts_json"
  ],
  "decision_policy": {
    "pass": "all cohorts are healthy reference cohorts and raw replay material is intact",
    "degraded": "one or more cohorts are degraded or blocked but warehouse evidence remains coherent enough to package replay material",
    "fail_closed": "raw references are missing, stale evidence is present, local fallback contamination is present, or cohort membership is contradictory"
  },
  "fail_closed_rules": [
    "missing raw artifact references fail closed",
    "warehouse schema drift fails closed",
    "stale warehouse timestamps or freshness markers fail closed",
    "contradictory cohort membership fails closed",
    "local fallback contamination fails closed"
  ],
  "required_error_codes": [
    "FE-SWARM-AUTOPILOT-COHORT-MISSING-RAW-REFERENCE",
    "FE-SWARM-AUTOPILOT-COHORT-SCHEMA-DRIFT",
    "FE-SWARM-AUTOPILOT-COHORT-STALE-REFERENCE",
    "FE-SWARM-AUTOPILOT-COHORT-CONTRADICTORY-MEMBERSHIP",
    "FE-SWARM-AUTOPILOT-COHORT-CONTAMINATED"
  ],
  "mutation_policy": {
    "advisory_only": true,
    "proof_only": true,
    "fixture_fed_only": true,
    "mutates_br": false,
    "releases_reservations": false,
    "sends_agent_mail": false,
    "runs_cargo": false,
    "runs_rch": false,
    "mutates_remote_workers": false,
    "changes_live_queue_policy": false
  },
  "required_doc_text": [
    "The packer is advisory only and proof only.",
    "Healthy reference cohorts remain distinct from degraded, blocked, and contaminated cohorts.",
    "Fallback-contaminated cohorts remain isolated from healthy reference cohorts.",
    "Contradictory cohort membership fails closed.",
    "Local fallback contamination must fail closed."
  ],
  "selftest_cases": [
    {
      "case_id": "healthy_reference_cohort_creation",
      "expected_decision": "pass",
      "expected_reference_count": 1,
      "required_classification": "reference"
    },
    {
      "case_id": "blocked_locality_contradiction",
      "expected_decision": "degraded",
      "expected_blocked_count": 1,
      "required_classification": "blocked"
    },
    {
      "case_id": "fallback_contaminated_isolation",
      "expected_decision": "fail_closed",
      "expected_contaminated_count": 1,
      "required_error_code": "FE-SWARM-AUTOPILOT-COHORT-CONTAMINATED",
      "required_classification": "contaminated"
    },
    {
      "case_id": "contradictory_cohort_rejection",
      "expected_decision": "fail_closed",
      "required_error_code": "FE-SWARM-AUTOPILOT-COHORT-CONTRADICTORY-MEMBERSHIP"
    },
    {
      "case_id": "stale_reference_fail_closed",
      "expected_decision": "fail_closed",
      "required_error_code": "FE-SWARM-AUTOPILOT-COHORT-STALE-REFERENCE"
    }
  ]
}

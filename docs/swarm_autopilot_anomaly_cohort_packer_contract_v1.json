    "report_md": "report.md"
  },
  "cohort_classifications": [
    "reference",
    "degraded",
    "blocked",
    "contaminated"
  ],
  "required_bundle_fields": [
    "warehouse_hash",
    "decision",
    "cohort_summary.total_cohort_count",
    "cohort_summary.reference_count",
    "cohort_summary.degraded_count",
    "cohort_summary.blocked_count",
    "cohort_summary.contaminated_count",
    "cohorts",
    "fail_closed_reasons",
    "artifact_paths.anomaly_cohorts_json",

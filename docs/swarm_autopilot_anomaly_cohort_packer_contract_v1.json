    "artifact_paths.evidence_warehouse_json",
    "artifact_paths.commands_txt",
    "artifact_paths.events_jsonl"
  ],
  "required_cohort_fields": [
    "cohort_id",
    "classification",
    "worker_ids",
    "toolchain_targets",
    "topology_classes",
    "failure_modes",
    "source_ids",
    "fingerprints",

  "source_bundle_schema_version": "franken-engine.swarm-autopilot-hindsight-source-bundle.v1",
  "scenarios_schema_version": "franken-engine.swarm-autopilot-hindsight-chaos-scenarios.v1",
  "replay_index_schema_version": "franken-engine.swarm-autopilot-hindsight-chaos-replay-index.v1",

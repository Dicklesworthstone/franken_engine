    "shipped_in_franken_engine": false,
    "local_renderer": false,
    "no_local_tui_runtime": true
  },
  "required_status_fields": [
    "operator_status_id",
    "decision",
    "truth_state",
    "summary.overall_state",
    "summary.top_action",
    "summary.safe_mode_active",
    "summary.degraded_panel_count",
    "summary.fail_closed_panel_count",
    "sections",
    "artifact_paths.operator_status_json",
    "artifact_paths.panel_bundle_json"
  ],
  "required_panel_bundle_fields": [
    "panel_bundle_id",
    "decision",
    "renderer_contract.provider",
    "renderer_contract.no_local_tui_runtime",
    "status_bar.summary.panel_count",
    "panels[].panel_id",
    "panels[].display_state",
    "panels[].semantic_theme_token",
    "panels[].focus_order",
    "panels[].aria_label",
    "panels[].supports_tiny_layout",
    "panels[].visible_reasons",
    "mutation_policy.local_renderer"
  ],
  "fail_closed_rules": [
    "hidden panel state fails closed",
    "missing evidence links fail closed",
    "fail-closed upstream policy, forecast, lease plan, recommendation bundle, or chaos replay inputs fail closed",
    "unsafe mutation-policy claims fail closed"
  ],
  "fixture_cases": [
    {
      "case_id": "healthy_autopilot",
      "expected_decision": "pass",
      "required_panel_id": "forecast_state",
      "required_panel_state": "healthy"
    },
    {
      "case_id": "degraded_forecast",
      "expected_decision": "degraded",
      "required_panel_id": "forecast_state",
      "required_panel_state": "degraded"
    },
    {
      "case_id": "fail_closed_policy_conflict",
      "expected_decision": "fail_closed",
      "required_error_code": "FE-SWARM-AUTOPILOT-STATUS-UPSTREAM-UNTRUSTED"
    },
    {
      "case_id": "safe_mode_recommendation",
      "expected_decision": "safe_mode",
      "required_panel_id": "safe_mode_state",
      "required_panel_state": "degraded"
    },
    {
      "case_id": "frankentui_panel_projection",
      "expected_decision": "pass",
      "required_panel_id": "required_operator_action",
      "required_top_action": "preserve_urgent_rch_slack"
    }
  ],
  "mutation_policy": {
    "advisory_only": true,
    "proof_only": true,
    "fixture_fed_only": true,
    "mutates_br": false,
    "reassigns_beads": false,
    "releases_reservations": false,
    "sends_agent_mail": false,
    "runs_cargo": false,
    "runs_rch": false,
    "mutates_remote_workers": false,
    "changes_live_queue_policy": false,
    "local_renderer": false
  },
  "validation_commands": [
    "bash -n scripts/swarm_autopilot_operator_status_bundle.sh",
    "bash -n scripts/e2e/swarm_autopilot_operator_status_bundle_smoke.sh",
    "shellcheck -x scripts/swarm_autopilot_operator_status_bundle.sh scripts/e2e/swarm_autopilot_operator_status_bundle_smoke.sh",
    "jq empty docs/swarm_autopilot_operator_status_contract_v1.json scripts/testdata/swarm_autopilot_operator_status/cases.json",
    "bash scripts/e2e/swarm_autopilot_operator_status_bundle_smoke.sh check",
    "bash scripts/e2e/swarm_autopilot_operator_status_bundle_smoke.sh selftest",
    "git diff --check -- docs/SWARM_AUTOPILOT_OPERATOR_STATUS.md docs/swarm_autopilot_operator_status_contract_v1.json scripts/swarm_autopilot_operator_status_bundle.sh scripts/e2e/swarm_autopilot_operator_status_bundle_smoke.sh scripts/testdata/swarm_autopilot_operator_status/cases.json"
  ]

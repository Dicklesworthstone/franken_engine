  "field_contract": {
    "workload_id": "stable snake_case id for the benchmark workload row",
    "benchmark_class": "high-level workload family or benchmark surface class",
    "purpose": "one sentence operator-facing reason this workload exists",
    "intent_tags": "operator intents that should route to this workload",
    "symptom_tags": "performance symptoms or claim-review states that should route to this workload",
    "required_inputs": "named source artifacts or evidence types required to consume the workload truthfully",
    "artifact_paths": "stable emitted artifact paths or canonical artifact naming patterns",
    "measurement_source": "primary source of truth for the workload's observed, blocked, or replay evidence",
    "benchmark_entrypoint": "repo-relative script or command wrapper that operators use to generate the workload evidence",
    "replay_entrypoint": "repo-relative replay or smoke helper path, or null when no replay path exists yet",
    "resource_profile": "summary of whether the workload is CPU-intensive, requires RCH, and whether warm/cold cache matters",
    "cold_warm_expectation": "operator-facing note describing whether warm cache or cold start matters for this workload",
    "rch_policy": "heavy validation command policy for examples and emitted command evidence",
    "mutation_policy": "booleans proving advisory-only behavior and forbidden live mutations",
    "result_schema": "schema version and result-state semantics for the benchmark artifacts",
    "operator_questions": "plain-language questions this workload helps answer",
    "owning_bead_id": "bead that introduced or truthfully governs the workload surface",
    "upstream_workload_ids": "benchmark workloads or surfaces that must be understood before this row",
    "downstream_workload_ids": "workloads or advisory surfaces expected to consume this row",
    "failure_reason_codes": "stable reason codes downstream consumers must preserve",
    "validation_commands": "commands that validate the workload or its source surface"
  },
  "global_mutation_policy": {
    "advisory_only": true,
    "proof_only": true,
    "fixture_fed_only": true,
    "mutates_br": false,
    "claims_beads": false,
    "reassigns_beads": false,
    "closes_beads": false,
    "releases_reservations": false,
    "sends_agent_mail": false,
    "queries_live_agent_mail": false,
    "mutates_git": false,
    "runs_cargo": false,
    "runs_rch": false,
    "mutates_remote_workers": false,
    "changes_live_queue_policy": false,
    "replaces_operator_status_report": false
  },
  "global_rch_policy": {
    "catalog_producer_runs_rch": false,
    "catalog_producer_runs_cargo": false,
    "heavy_cargo_examples_must_start_with": "rch exec -- env CARGO_TARGET_DIR=",
    "benchmark_suite_wrappers_are_allowed": true,
    "bare_heavy_cargo_is_fail_closed": true,
    "allowed_local_non_cargo_validation": [
      "jq empty",
      "jq -e",
      "bash -n",
      "shellcheck -x",
      "git diff --check"
    ]
  },
  "source_freshness_policy": {
    "required_sources_missing_decision": "fail_closed",
    "required_sources_stale_decision": "fail_closed",
    "required_sources_malformed_decision": "fail_closed",
    "optional_sources_missing_decision": "degraded",
    "catalog_rows_must_name_optional_sources": true,
    "blocked_measurements_must_remain_explicit": true
  },

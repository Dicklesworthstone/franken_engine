    "FE-SWARM-CATALOG-BARE-HEAVY-CARGO",
    "FE-SWARM-CATALOG-STALE-SOURCE"
  ],
  "field_contract": {
    "surface_id": "stable snake_case id for the catalog row",
    "track": "owning swarm-control, swarm-scale, or swarm-autopilot track",
    "purpose": "one sentence operator-facing reason this surface exists",
    "intent_tags": "operator intents that should route to this surface",
    "symptom_tags": "failure symptoms or queue states that should route to this surface",
    "required_inputs": "named source artifacts or snapshots required by the surface",
    "emitted_artifacts": "stable output artifacts produced by the surface",
    "implementation_script": "repo-relative implementation script path, or null only when the row is contract-only and degraded",
    "smoke_script": "repo-relative smoke script path, or null only when the row is contract-only and degraded",
    "runbook_doc": "repo-relative markdown doc path",
    "contract_json": "repo-relative JSON contract path",
    "owning_bead_id": "bead that introduced or currently owns the surface",
    "upstream_surface_ids": "surface ids that must be consumed or reviewed before this surface",
    "downstream_surface_ids": "surface ids that are expected consumers",
    "mutation_policy": "booleans proving advisory-only behavior and forbidden live mutations",
    "rch_policy": "heavy validation command policy for examples and emitted command evidence",
    "source_freshness_policy": "freshness windows and stale-source decisions for required sources",
    "operator_status_section": "section name in scripts/swarm_operator_status_report.sh handoff, or null when not yet surfaced",
    "failure_reason_codes": "stable reason codes that consumers must preserve",
    "validation_commands": "commands that validate the row or its source surface"
  },
  "global_mutation_policy": {
    "advisory_only": true,
    "proof_only": true,
    "fixture_fed_only": true,
    "mutates_br": false,
    "claims_beads": false,
    "reassigns_beads": false,
    "closes_beads": false,
    "releases_reservations": false,
    "sends_agent_mail": false,
    "queries_live_agent_mail": false,
    "mutates_git": false,
    "runs_cargo": false,
    "runs_rch": false,
    "mutates_remote_workers": false,
    "changes_live_queue_policy": false,
    "replaces_operator_status_report": false
  },
  "global_rch_policy": {
    "catalog_producer_runs_rch": false,
    "catalog_producer_runs_cargo": false,
    "heavy_cargo_examples_must_start_with": "rch exec -- env CARGO_TARGET_DIR=",
    "bare_heavy_cargo_is_fail_closed": true,
    "allowed_local_non_cargo_validation": [
      "jq empty",
      "jq -e",
      "bash -n",
      "shellcheck -x",
      "git diff --check"
    ]
  },
  "source_freshness_policy": {
    "required_sources_missing_decision": "fail_closed",
    "required_sources_stale_decision": "fail_closed",
    "required_sources_malformed_decision": "fail_closed",
    "optional_sources_missing_decision": "degraded",
    "catalog_rows_must_name_optional_sources": true,
    "freshness_windows_are_surface_specific": true
  },
  "operator_status_handoff": {
    "single_producer": "scripts/swarm_operator_status_report.sh",
    "catalog_may_emit_section_names": true,
    "catalog_may_replace_status_producer": false,
    "catalog_may_claim_automatic_remediation": false

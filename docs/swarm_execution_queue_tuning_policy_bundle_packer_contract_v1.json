      "hash_required": true
    },
    {
      "field": "counterfactual_backtest_report_json",
      "argument": "--counterfactual-backtest-report-json",
      "schema_version": "franken-engine.swarm-execution-queue-counterfactual-backtest-report.v1",
      "hash_required": true
    },
    {
      "field": "tuning_plan_json",
      "argument": "--tuning-plan-json",
      "schema_version": "franken-engine.swarm-execution-queue-tuning-plan.v1",
      "hash_required": true
    },
    {
      "field": "frontier_json",
      "argument": "--frontier-json",
      "schema_version": "franken-engine.swarm-execution-queue-counterfactual-frontier.v1",
      "hash_required": true
    },
    {
      "field": "operator_status_json",
      "argument": "--operator-status-json",
      "schema_version_required": true,
      "hash_required": true
    }

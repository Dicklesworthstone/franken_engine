  "required_rollback_references": [
    "--prior-policy-bundle-id",
    "--prior-frontier-json",
    "--rollback-comparator-report-json",
    "--canary-verdict-ledger-json"
  ],
  "artifact_paths": {
    "tuning_policy_bundle_json": "tuning_policy_bundle.json",
    "policy_frontier_export_json": "policy_frontier_export.json",
    "evidence_hashes_json": "evidence_hashes.json",
    "events_jsonl": "events.jsonl",
    "commands_txt": "commands.txt",
    "report_md": "report.md"
  },
  "plan_classes": [
    "no_improvement",
    "one_clear_improvement",
    "conflicting_improvements",
    "insufficient_evidence",
    "fail_closed"
  ],
  "mutation_policy": {
    "planning_artifact_only": true,
    "changes_active_queue": false,
    "applies_live_retuning": false,
    "mutates_br": false,
    "sends_agent_mail": false,
    "mutates_remote_workers": false,
    "rewrites_historical_outcomes": false,
    "operator_wording_required": "advisory-only planning artifact"
  },
  "fail_closed_rules": [
    "upstream fail-closed evidence fails closed",
    "missing candidate rankings fail closed",
    "promoted candidate absent from ranking fails closed",
    "frontier candidates absent from ranking fail closed",
    "automatic live-retuning claims fail closed",
    "rollback references missing fail closed",
    "reject local fallback proof evidence"
  ],
  "selftest_scenarios": [
    "no_improvement",
    "one_clear_improvement",
    "conflicting_frontiers",
    "incomplete_evidence_fail_closed"
  ],
  "verification_commands": [
    "bash -n scripts/swarm_execution_queue_tuning_policy_bundle_packer.sh",
    "bash -n scripts/e2e/swarm_execution_queue_tuning_policy_bundle_packer_smoke.sh",
    "shellcheck -x scripts/swarm_execution_queue_tuning_policy_bundle_packer.sh scripts/e2e/swarm_execution_queue_tuning_policy_bundle_packer_smoke.sh",
    "jq empty docs/swarm_execution_queue_tuning_policy_bundle_packer_contract_v1.json",
    "bash scripts/e2e/swarm_execution_queue_tuning_policy_bundle_packer_smoke.sh check",
    "bash scripts/e2e/swarm_execution_queue_tuning_policy_bundle_packer_smoke.sh selftest"
  ]

  "capacity_signals": [
    {
      "signal_id": "active_cargo_rustc_count",
      "source_kind": "process_scan",
      "capture_command": "pgrep -af 'cargo|rustc' | wc -l",
      "required_for_decision": true,
      "missing_evidence_decision": "fail_closed",
      "degraded_decision": "defer",
      "notes": "A high local compiler count means a new heavy validation should wait or request a narrower rch-only plan."
    },
    {
      "signal_id": "disk_available_bytes",
      "source_kind": "filesystem",
      "capture_command": "df -PB1 . /tmp",
      "required_for_decision": true,
      "missing_evidence_decision": "fail_closed",
      "degraded_decision": "fail_closed",
      "notes": "Low disk or unknown disk state can corrupt target dirs and proof artifacts; it must stop heavy validation."
    },
    {
      "signal_id": "file_reservation_overlap",
      "source_kind": "agent_mail",
      "capture_command": "file_reservation_paths(paths=planned_write_set, exclusive=true)",
      "required_for_decision": true,
      "missing_evidence_decision": "fail_closed",
      "degraded_decision": "defer",
      "notes": "When Agent Mail is unavailable, bead assignee and dirty paths are fallback evidence but must be reported as degraded."
    },
    {
      "signal_id": "git_dirty_state",
      "source_kind": "git",
      "capture_command": "git status --short",
      "required_for_decision": true,
      "missing_evidence_decision": "fail_closed",
      "degraded_decision": "admit_narrow",
      "notes": "Dirty unrelated files do not block narrow work, but dirty overlapping files require deferral or a different bead."
    },
    {
      "signal_id": "memory_available_bytes",
      "source_kind": "procfs",
      "capture_command": "awk '/MemAvailable/ {print $2 * 1024}' /proc/meminfo",
      "required_for_decision": false,
      "missing_evidence_decision": "admit_narrow",
      "degraded_decision": "defer",
      "notes": "Memory is useful on large swarm hosts, but older environments may not expose it consistently."
    },
    {
      "signal_id": "rch_local_fallback",
      "source_kind": "rch_log",
      "capture_command": "scan rch output for local fallback markers",
      "required_for_decision": true,
      "missing_evidence_decision": "fail_closed",
      "degraded_decision": "fail_closed",
      "notes": "Heavy commands must reject local fallback instead of silently consuming local disk and CPU."
    },
    {
      "signal_id": "rch_status",
      "source_kind": "rch",
      "capture_command": "rch status",
      "required_for_decision": true,
      "missing_evidence_decision": "fail_closed",
      "degraded_decision": "defer",
      "notes": "If remote execution health is unknown, the planner can emit a plan but the governor must not admit heavy execution."
    },
    {
      "signal_id": "target_dir_writable",
      "source_kind": "filesystem",
      "capture_command": "test -w \"$CARGO_TARGET_DIR\" || mkdir -p \"$CARGO_TARGET_DIR\"",
      "required_for_decision": true,
      "missing_evidence_decision": "fail_closed",
      "degraded_decision": "fail_closed",
      "notes": "Every heavy rch command must set a writable off-repo CARGO_TARGET_DIR."
    }
  ],
